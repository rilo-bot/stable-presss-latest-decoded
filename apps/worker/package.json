{
  "name": "@rilo/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Magazine Builder v2 background worker — PDF extraction + the Mongo poll job queue. Runs as a separate process from the API so CPU-heavy MuPDF rasterization never blocks the API event loop.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ai": "^7.0.170",
    "dotenv": "^16.4.0",
    "mupdf": "^1.28.0",
    "puppeteer": "^25.2.1",
    "sharp": "^0.35.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
