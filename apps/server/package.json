{
  "name": "@rilo/server",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check:types": "tsc --noEmit -p tsconfig.scripts.json",
    "check:permissions": "tsx scripts/check-permission-enforcement.ts",
    "check:admins": "tsx scripts/check-admins.ts",
    "migrate:admin-roles": "tsx scripts/migrate-admin-roles.ts",
    "migrate:permissions": "tsx scripts/migrate-permissions.ts",
    "sync:roles": "tsx scripts/sync-role-catalogue.ts",
    "grant:superadmin": "tsx scripts/grant-superadmin.ts",
    "sweep:orphans": "tsx scripts/sweep-orphan-objects.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "ai": "^6.0.205",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "isomorphic-dompurify": "^3.17.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongodb": "^6.12.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^25.2.1",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0"
  }
}
