# ============================================================================
#  apps/server/.env.example  —  copy to apps/server/.env and fill in.
#  In deployment (Render) set these as the server service's environment
#  variables instead — .env is for local dev only and is gitignored.
# ============================================================================

# --- Core ---
PROD=true                      # security posture only (JWT secret + OTP delivery). DB is always MongoDB.
PORT=8080
MONGODB_URI=                   # mongodb+srv://...   REQUIRED in every environment — no in-memory fallback
JWT_SECRET=                    # long random string
OTP_TTL_MINUTES=10
# DEV_OTP_CODE=123456          # local only: fixed sign-in code, skips email. FULL auth bypass — never set in production.
SETUP_SECRET=                  # secret for the first-admin seed endpoint

# --- Email ---
# Provider precedence: Resend (primary) → SMTP (fallback) → dev console.
# Resend is the intended provider. If Resend is unset OR a Resend send fails at
# runtime, mail falls back to the SMTP server below. With neither set, mail is
# logged, not sent — invites still save, they just don't reach anyone.
# Resend key: https://resend.com/api-keys.  The from-address must be on a domain
# you have verified in Resend, or every send is rejected.
RESEND_API_KEY=                # re_...
RESEND_FROM_EMAIL=             # e.g. "Stable Press <newsroom@yourdomain.com>"

# SMTP fallback (any standard SMTP server). Used when Resend is unconfigured or a
# Resend send fails. SMTP_FROM defaults to RESEND_FROM_EMAIL if omitted.
SMTP_HOST=                     # e.g. smtp.yourprovider.com
SMTP_PORT=                     # 587 (STARTTLS) or 465 (implicit TLS); default 587
SMTP_USER=                     # SMTP username (omit for an unauthenticated relay)
SMTP_PASS=                     # SMTP password
SMTP_SECURE=                   # true for port 465; leave blank for 587
SMTP_FROM=                     # e.g. "Stable Press <newsroom@yourdomain.com>"

# REQUIRED for team invitations — the public origin of the WEB app, used to
# build the accept link (`{WEB_PUBLIC_URL}/invite/<token>`) that goes in the
# email. Defaults to http://localhost:5173, so leaving it unset in a deployed
# environment emails people a link to their own machine.
WEB_PUBLIC_URL=                # e.g. https://stablepress.example.com

# --- AI assistant ("the Stablehand", via OpenRouter) ---
# Get a key at https://openrouter.ai/keys. Without it the assistant returns a
# friendly "resting" message (503) and the rest of the app is unaffected.
OPENROUTER_API_KEY=
# Optional — defaults to anthropic/claude-sonnet-4.6. Set the EXACT slug from
# https://openrouter.ai/models if you want a different model/version.
# AGENT_MODEL=anthropic/claude-sonnet-4.6

# --- Magazine Builder v2 — stock photos (Pexels) for "Build with AI" ---
# Free key at https://www.pexels.com/api/. Without it (or without S3 below),
# generated image slots degrade to flat palette blocks instead of real photos.
# Fetched photos are stored as MediaAssets in your S3 bucket (no hotlinking).
# STOCK_PROVIDER=pexels          # default; the only provider wired
PEXELS_API_KEY=
# Optional — pages generated in parallel (each is a few LLM calls + photo fetches).
# MAGAZINE_V2_GEN_CONCURRENCY=2

# --- Magazine Builder v2 — background worker (apps/worker; PDF import) ---
# The worker is a SEPARATE process that digitizes uploaded PDFs (MuPDF is
# CPU-heavy and would block the API). It reads THIS same .env (MONGODB_URI +
# S3). Run locally with `npm run -w apps/worker dev`; in deployment run it as
# its own service. Extraction needs S3 configured; without it, import degrades.
# MAGAZINE_V2_POLL_INTERVAL_MS=2000   # how often the worker polls the job queue

# --- Voice (the Stablehand's ears + mouth, via OpenAI) ---
# Enables push-to-talk: OpenAI does speech-to-text + text-to-speech while Claude
# stays the brain. Without this key the mic just doesn't appear; text chat is
# unaffected. Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# Optional model/voice overrides:
# VOICE_STT_MODEL=gpt-4o-mini-transcribe
# VOICE_TTS_MODEL=gpt-4o-mini-tts
# VOICE_TTS_VOICE=alloy
# Spoken-input language (ISO-639-1). Defaults to 'en' so short clips aren't
# mis-detected as another language. Set to '' for auto-detect (multilingual).
# VOICE_STT_LANGUAGE=en

# --- Object storage (S3 uploads) ---
# When ALL of S3_BUCKET, S3_REGION, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# are set, uploads go to S3 (server-proxied: browser → our API → S3, no bucket
# CORS needed). Leave them blank to fall back to inline data URLs.
# The bucket can stay FULLY PRIVATE — files are served back by streaming through
# GET /api/uploads/file/<key> (no public-access policy required). See
# S3_PUBLIC_BASE_URL below to serve public images straight from the bucket instead.
S3_BUCKET=                     # e.g. stable-press-uploads
S3_REGION=                     # e.g. ap-southeast-2
AWS_ACCESS_KEY_ID=             # IAM key with s3:PutObject + s3:GetObject on the bucket
AWS_SECRET_ACCESS_KEY=
# The API's own public origin. Only used for keys OUTSIDE `public/` (identity
# documents), which are the ones served through this API — public images go
# straight to the bucket. Still worth setting in deployment: without it those URLs
# are stored RELATIVE and would 404 against the web host, a different origin.
# Unset in local dev, where relative '/api/...' resolves via the Vite proxy.
# API_PUBLIC_URL=https://your-api.onrender.com
#
# ── How images are served ──
# Objects whose key starts with `public/` are served STRAIGHT FROM THE BUCKET by
# default — the origin is derived from S3_BUCKET + S3_REGION, so there is nothing
# to configure. Everything else (currently `evidence/`: identity documents) is
# written outside that prefix and is only readable through this API.
#
# This REQUIRES the bucket policy that grants anonymous read on the prefix ONLY:
#   { "Effect": "Allow", "Principal": "*", "Action": "s3:GetObject",
#     "Resource": "arn:aws:s3:::<bucket>/public/*" }
# plus "Block all public access" turned off at the policy level for that bucket.
#
# S3_PUBLIC_BASE_URL overrides the derived origin — set it to put a CDN in front.
# Set it to `none` for a bucket WITHOUT that policy: everything then goes through
# the API proxy, which is correct but slower, and the only safe setting there.
# S3_PUBLIC_BASE_URL=          # e.g. https://cdn.example.com   — or `none` to force proxying
# S3_OBJECT_ACL=none           # this bucket has ACLs disabled; 'none' skips a PutObject ACL that always fails and retries
# S3_ENDPOINT=                 # custom endpoint for S3-compatible providers (R2/MinIO/Spaces)
# S3_FORCE_PATH_STYLE=true     # set with S3_ENDPOINT for MinIO-style path addressing
