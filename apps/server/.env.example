# ============================================================================
#  apps/server/.env.example  —  copy to apps/server/.env and fill in.
#  In deployment (Render) set these as the server service's environment
#  variables instead — .env is for local dev only and is gitignored.
# ============================================================================

# --- Core ---
PROD=true                      # security posture only (JWT secret + OTP delivery). DB is always MongoDB.
PORT=8080
MONGODB_URI=                   # mongodb+srv://...   REQUIRED in every environment — no in-memory fallback
JWT_SECRET=                    # long random string
OTP_TTL_MINUTES=10
# DEV_OTP_CODE=123456          # local only: fixed sign-in code, skips email. FULL auth bypass — never set in production.
SETUP_SECRET=                  # secret for the first-admin seed endpoint

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- AI assistant ("the Stablehand", via OpenRouter) ---
# Get a key at https://openrouter.ai/keys. Without it the assistant returns a
# friendly "resting" message (503) and the rest of the app is unaffected.
OPENROUTER_API_KEY=
# Optional — defaults to anthropic/claude-sonnet-4.6. Set the EXACT slug from
# https://openrouter.ai/models if you want a different model/version.
# AGENT_MODEL=anthropic/claude-sonnet-4.6

# --- Voice (the Stablehand's ears + mouth, via OpenAI) ---
# Enables push-to-talk: OpenAI does speech-to-text + text-to-speech while Claude
# stays the brain. Without this key the mic just doesn't appear; text chat is
# unaffected. Get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# Optional model/voice overrides:
# VOICE_STT_MODEL=gpt-4o-mini-transcribe
# VOICE_TTS_MODEL=gpt-4o-mini-tts
# VOICE_TTS_VOICE=alloy
# Spoken-input language (ISO-639-1). Defaults to 'en' so short clips aren't
# mis-detected as another language. Set to '' for auto-detect (multilingual).
# VOICE_STT_LANGUAGE=en

# --- Object storage (S3 uploads) ---
# When ALL of S3_BUCKET, S3_REGION, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# are set, uploads go to S3 (server-proxied: browser → our API → S3, no bucket
# CORS needed). Leave them blank to fall back to inline data URLs.
# The bucket can stay FULLY PRIVATE — files are served back by streaming through
# GET /api/uploads/file/<key> (no public-access policy required).
S3_BUCKET=                     # e.g. stable-press-uploads
S3_REGION=                     # e.g. ap-southeast-2
AWS_ACCESS_KEY_ID=             # IAM key with s3:PutObject + s3:GetObject on the bucket
AWS_SECRET_ACCESS_KEY=
# Recommended in deployment — the API's own public origin, used to build viewable
# file URLs. Unset in local dev (relative '/api/...' paths resolve via the proxy).
# API_PUBLIC_URL=https://your-api.onrender.com
# Optional:
# S3_PUBLIC_BASE_URL=          # if you instead make the bucket public / use a CDN; bypasses the file-proxy
# S3_OBJECT_ACL=none           # set 'none' for buckets with ACLs disabled (default tries 'public-read', falls back automatically)
# S3_ENDPOINT=                 # custom endpoint for S3-compatible providers (R2/MinIO/Spaces)
# S3_FORCE_PATH_STYLE=true     # set with S3_ENDPOINT for MinIO-style path addressing
