# Dependencies
node_modules/

# Build output
dist/
apps/*/dist/

# Puppeteer's Chromium, relocated into the repo by .puppeteerrc.cjs so it
# survives Render's build -> runtime hand-off. Hundreds of MB of binary.
.cache/

# Env / secrets (the bare ".env" rule already matches these in every folder,
# listed explicitly for clarity)
.env
.env.*
!.env.example
apps/server/.env
apps/web/.env

# Deploy script + credentials (kept local, not deployed)
deploy.ps1
deploy.secrets.ps1

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
